# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local runtime noise (kept small on purpose; memory IS versioned)
# memory/events.jsonl and missions.jsonl are small and versioned.

# CLIENT DATA BOUNDARY (Phase 10): real client personal/financial data
# (voice notes, quotes, contacts, payment receipts with bank references)
# stays on the operator's machine. Only code, config, kit docs and synthetic
# test fixtures (generated in temp dirs) are versioned.
experiments/*/evidence/*
!experiments/*/evidence/.gitkeep
memory/commercial/
memory/business_profiles/

# Production copies of the experiment kit's tracker/log hold real client
# personal data. The header-only TEMPLATES (prospect_tracker.csv,
# experiment_log.md) stay tracked and pristine; real data is written only to
# the .local. production copies created on the operator's machine, which can
# never be committed. (gitignore cannot protect tracked files — that is why
# production data uses separate .local. files, never the templates.)
experiments/*/*.local.csv
experiments/*/*.local.md
